{
  "id": "com.youdao.translator",
  "name": "有道翻译官",
  "groups": [
    {
      "key": 1,
      "name": "分段广告-翻译结果下方广告",
      "desc": "①点击[x]掉 ②点击[不再展示]",
      "fastQuery": true,
      "activityIds": ".activity.trans.TransResultActivity",
      "rules": [
        {
          "key": 0,
          "name": "①点击[x]掉",
          "matches": "@ImageView[vid=\"close_iv\"] + [vid=\"native_ad_flag_tv\"]"
        },
        {
          "preKeys": [
            0
          ],
          "name": "②点击[不再展示]",
          "matches": "[text*=\"不再展示\"][clickable=true]"
        }
      ]
    }
  ]
}
