{
  "id": "com.tencent.mm",
  "name": "微信",
  "groups": [
    {
      "key": 0,
      "name": "分段广告-朋友圈广告",
      "desc": "广告入口绑定已知控件和广告反馈面板；隐藏/空白入口仅适用已有快照验证的版本。取消无广告证据的返回和取消补救。",
      "activityIds": [
        ".plugin.sns.ui.SnsTimeLineUI",
        ".plugin.sns.ui.improve.ImproveSnsTimelineUI",
        ".plugin.profile.ui.ContactInfoUI"
      ],
      "rules": [
        {
          "key": 0,
          "name": "①点击[广告]",
          "fastQuery": true,
          "matches": "@[id=\"com.tencent.mm:id/jw\" || id=\"com.tencent.mm:id/fj\"][clickable=true][visibleToUser=true][width>0 && height>0] > [text=\"广告\" || text=\"廣告\" || text=\"Sponsored\"][visibleToUser=true]"
        },
        {
          "key": 1,
          "name": "①旧版本隐藏广告入口（已知广告控件坐标）",
          "fastQuery": true,
          "actionDelay": 0,
          "position": {
            "left": "width * 0.9223",
            "top": "height * 0.5"
          },
          "versionCode": {
            "include": [
              2580,
              2600,
              2820
            ]
          },
          "matches": "@[id=\"com.tencent.mm:id/kbe\"][childCount=2][visibleToUser=true][height>0 && height<200 && width>500] > [id=\"com.tencent.mm:id/jw\"][visibleToUser=false]"
        },
        {
          "key": 2,
          "name": "①旧版本空白广告入口（已知控件ID链）",
          "versionCode": {
            "include": [
              2020,
              2820
            ]
          },
          "anyMatches": [
            "[id=\"com.tencent.mm:id/fzb\"] > @[id=\"com.tencent.mm:id/fj\"][childCount=0][clickable=true][visibleToUser=true][width>0 && height>0]",
            "[id=\"com.tencent.mm:id/kbe\"] > @[id=\"com.tencent.mm:id/jw\"][childCount=0][clickable=true][visibleToUser=true][width>0 && height>0]"
          ]
        },
        {
          "preKeys": [
            0,
            1,
            2
          ],
          "key": 25,
          "name": "②点击[关闭]",
          "fastQuery": true,
          "anyMatches": [
            "[text*=\"广告\" || text*=\"廣告\" || text*=\" ad\"][visibleToUser=true] < [id=\"com.tencent.mm:id/n2o\" || id=\"com.tencent.mm:id/huk\"] > @[id=\"com.tencent.mm:id/n2m\"][text=\"关闭该广告\" || text=\"關閉此廣告\" || text=\"Close the ad\"][clickable=true][visibleToUser=true][width>0 && height>0]",
            "[text=\"广告反馈\" || text=\"\\\"Ad feedback\\\"\"][visibleToUser=true] < LinearLayout < LinearLayout > FrameLayout > @[text=\"关闭广告\" || text=\"\\\"Close Ad\\\"\"][clickable=true][visibleToUser=true][width>0 && height>0]",
            "[text=\"赞助商提供的广告信息\" || text=\"Sponsored story\"][visibleToUser=true] < [id=\"com.tencent.mm:id/n2o\" || id=\"com.tencent.mm:id/huk\"] >n @[id=\"com.tencent.mm:id/n2t\" || id=\"com.tencent.mm:id/hup\"][clickable=true][visibleToUser=true][width>0 && height>0]"
          ]
        },
        {
          "preKeys": [
            25
          ],
          "key": 50,
          "name": "③点击[关闭]",
          "matches": "[text=\"关闭该广告的原因\" || text=\"Reason for closing the ad\" || text=\"不感兴趣原因\"][visibleToUser=true] < [id=\"com.tencent.mm:id/n2o\" || id=\"com.tencent.mm:id/huk\"] >n @[text=\"直接关闭\" || text=\"Close\" || text=\"关闭广告\"][clickable=true][visibleToUser=true][width>0 && height>0]"
        },
        {
          "preKeys": [
            50
          ],
          "key": 75,
          "name": "④点击[确认]",
          "fastQuery": true,
          "matches": "[id=\"com.tencent.mm:id/huk\"] > [text=\"不感兴趣原因\"][visibleToUser=true] +2 @[id=\"com.tencent.mm:id/hui\"][text=\"确认\"][clickable=true][visibleToUser=true][width>0 && height>0]"
        }
      ],
      "matchRoot": true
    },
    {
      "key": 1,
      "name": "功能类-微信设备快捷登录",
      "desc": "自动点击[登录]Win/Mac/平板/手表等客户端",
      "fastQuery": true,
      "matchTime": 10000,
      "actionMaximum": 1,
      "rules": [
        {
          "activityIds": [
            ".plugin.webwx.ui.ExtDeviceWXLoginUI",
            ".ui.LauncherUI"
          ],
          "matches": "RelativeLayout[vid!=null][left!=0] > ImageView[width = height] + TextView[text^=\"登录\" || text^=\"登入\" || text^=\"Log in to Weixin for\"][visibleToUser=true] +n * > Button[text=\"登录\" || text=\"登入\" || text=\"Log In\"][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 2,
      "name": "功能类-自动授权登录",
      "desc": "自动允许使用头像昵称等",
      "fastQuery": true,
      "actionMaximum": 1,
      "rules": [
        {
          "key": 0,
          "activityIds": [
            ".plugin.base.stub.UIEntryStub",
            ".ui.LauncherUI",
            ".plugin.webview.ui.tools.MMWebViewUI",
            ".plugin.webview.ui.tools.SDKOAuthUI"
          ],
          "matches": [
            "[text^=\"获取你的\" || text^=\"取得你的\" || text^=\"你的昵称\"]",
            "[text=\"允许\" || text=\"允許\"]"
          ]
        },
        {
          "preKeys": [
            0
          ],
          "activityIds": ".plugin.webview.ui.tools.SDKOAuthOtherUI",
          "matches": [
            "[text=\"申请获得\"][visibleToUser=true]",
            "[text=\"允许\"][visibleToUser=true]"
          ]
        }
      ]
    },
    {
      "key": 4,
      "name": "功能类-微信读书网页版扫码登录自动授权",
      "matchTime": 10000,
      "actionMaximum": 1,
      "activityIds": ".plugin.webview.ui.tools.MMWebViewUI",
      "rules": [
        {
          "key": 1,
          "matches": "[text=\"微信读书网页版\"] +3 Button[text=\"登 录\"]"
        },
        {
          "preKeys": [
            1
          ],
          "key": 2,
          "action": "back",
          "matches": "[text=\"登录成功\"]"
        }
      ]
    },
    {
      "key": 5,
      "name": "功能类-自动领取红包",
      "desc": "自动领取私聊红包,群聊红包",
      "fastQuery": true,
      "rules": [
        {
          "key": 1,
          "name": "点击别人发的红包",
          "activityIds": [
            ".ui.LauncherUI",
            ".ui.chatting.variants.ChattingMainUI"
          ],
          "matches": "LinearLayout[childCount=1] >2 @FrameLayout[clickable=true] >3 [childCount=1] <2 LinearLayout +(1,2) RelativeLayout > [text=\"微信红包\"]"
        },
        {
          "preKeys": [
            1
          ],
          "key": 2,
          "name": "点击红包-开",
          "matchRoot": true,
          "activityIds": ".plugin.luckymoney.ui.LuckyMoney",
          "matches": "@Button[desc=\"开\" || desc=\"開\"] -(2,3) LinearLayout >2 [text$=\"红包\" || text$=\"紅包\"]"
        },
        {
          "preKeys": [
            1,
            2
          ],
          "name": "从红包结算界面返回",
          "activityIds": ".plugin.luckymoney.ui.LuckyMoney",
          "matches": "@ImageView[desc=\"返回\"] +n LinearLayout >8 [text$=\"红包\" || text$=\"紅包\"]"
        }
      ]
    },
    {
      "key": 6,
      "name": "功能类-自动[关闭]已抢完的红包",
      "desc": "点击x掉",
      "rules": [
        {
          "fastQuery": true,
          "activityIds": ".plugin.luckymoney.ui.LuckyMoneyNewReceiveUI",
          "matches": "@[desc=\"关闭\"] - [visibleToUser=true] >3 [text^=\"手慢了\"][text*=\"红包\"][text.length<15]"
        }
      ]
    },
    {
      "key": 7,
      "name": "功能类-自动[选中]发送原图",
      "desc": "自动选中底部中间的发送原图，可手动取消勾选",
      "fastQuery": true,
      "actionMaximum": 1,
      "actionMaximumKey": 1,
      "activityIds": [
        ".plugin.gallery.ui.AlbumPreviewUI",
        ".plugin.gallery.ui.ImagePreviewUI",
        ".plugin.picker.LocalMediaPickerUI",
        ".plugin.picker.preview.LocalMediaPreviewUI"
      ],
      "rules": [
        {
          "key": 1,
          "matches": "@[clickable=true][desc^=\"未选中\" || desc^=\"未選定\" || desc^=\"Unselected\"] + [text=\"原图\" || text=\"原圖\" || text=\"Full Image\"][visibleToUser=true]"
        },
        {
          "key": 2,
          "matches": "@[clickable=true] > [checkable=true][checked=false] + [text=\"原图\" || text=\"原圖\" || text=\"Full Image\"][visibleToUser=true]"
        },
        {
          "key": 3,
          "matches": "[clickable=true][desc^=\"未选中\" || desc^=\"未選定\" || desc^=\"Unselected\"][!(desc*=\"选择\")][text=null]"
        }
      ]
    },
    {
      "key": 9,
      "name": "功能类-自动查看原图",
      "desc": "自动点击底部左侧[查看原图]按钮",
      "activityIds": [
        ".ui.chatting.gallery.ImageGalleryUI",
        ".ui.LauncherUI"
      ],
      "rules": [
        {
          "key": 0,
          "fastQuery": true,
          "anyMatches": [
            "Button[text^=\"查看\"][clickable=true][visibleToUser=true]",
            "Button[clickable=true][text^=\"查看\"][visibleToUser=true]"
          ]
        },
        {
          "key": 1,
          "activityIds": ".ui.LauncherUI",
          "matches": "[text^=\"原图\"][clickable=true][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 10,
      "name": "开屏广告-微信小程序",
      "fastQuery": true,
      "matchTime": 10000,
      "forcedTime": 10000,
      "priorityTime": 10000,
      "activityIds": [
        ".plugin.appbrand.ui.AppBrandUI",
        ".plugin.appbrand.launching.AppBrandLaunchProxyUI",
        ".plugin.appbrand.ui.AppBrandPluginUI"
      ],
      "rules": [
        {
          "key": 0,
          "actionDelay": 800,
          "matches": [
            "[text=\"广告\" || text=\"廣告\"][visibleToUser=true]",
            "[text=\"跳过\" || text=\"跳過\"][visibleToUser=true]"
          ]
        },
        {
          "key": 1,
          "matchRoot": true,
          "actionCd": 500,
          "matches": "@TextView[text*=\"跳过\"][text.length<10][height<150] <<(25-n) FrameLayout[childCount=2] <(1,2) * < [id=\"android:id/content\"]"
        }
      ],
      "order": -10
    },
    {
      "key": 11,
      "name": "功能类-网页版文件传输助手扫码自动授权",
      "fastQuery": true,
      "matchTime": 10000,
      "actionMaximum": 1,
      "rules": [
        {
          "activityIds": ".ui.LauncherUI",
          "matches": "[text=\"打开网页版文件传输助手\"] + * > Button[text=\"打开\"]"
        }
      ]
    },
    {
      "key": 17,
      "name": "青少年模式",
      "fastQuery": true,
      "matchTime": 20000,
      "actionMaximum": 1,
      "activityIds": [
        ".plugin.finder.",
        ".ui.LauncherUI"
      ],
      "rules": [
        {
          "key": 0,
          "matches": "@[text=\"我知道了\"][index=parent.childCount.minus(1)] <n LinearLayout > [text^=\"为呵护未成年人健康成长\"][visibleToUser=true]"
        },
        {
          "key": 1,
          "matches": "@[text=\"不再提醒\"][clickable=true] <2 [index=parent.childCount.minus(1)] -n [text^=\"为呵护未成年人健康成长\"][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 18,
      "name": "功能类-青少年模式自动点击验证密码",
      "desc": "点击“验证密码”以申请临时访问",
      "matchTime": 10000,
      "actionMaximum": 1,
      "rules": [
        {
          "key": 0,
          "fastQuery": true,
          "activityIds": ".plugin.teenmode.ui.AuthorizationRequestUI",
          "matches": "@LinearLayout[childCount=2] > TextView[text=\"验证密码\"]"
        },
        {
          "key": 1,
          "activityIds": ".plugin.webview.ui.tools.MMWebViewUI",
          "matches": "View[desc=\"验证密码\"][clickable=true]"
        }
      ]
    },
    {
      "key": 19,
      "name": "功能类-订阅号-展开更早的消息",
      "rules": [
        {
          "key": 0,
          "fastQuery": true,
          "activityIds": ".plugin.brandservice.ui.timeline.BizTimeLineUI",
          "matches": "@[clickable=true] > [text=\"展开更早的消息\"]"
        },
        {
          "key": 1,
          "matches": "[desc=\"展开更早的消息\"]"
        }
      ]
    },
    {
      "key": 22,
      "name": "功能类-开启青少年模式后的每日验证",
      "desc": "点击\"验证密码\"",
      "rules": [
        {
          "action": "clickCenter",
          "activityIds": ".plugin.webview.ui.tools.MMWebViewUI",
          "matches": "WebView[childCount=6] View[index=4] > [text=\"验证密码\"][clickable=true]"
        }
      ]
    },
    {
      "key": 25,
      "name": "局部广告-订阅号消息-推荐文章",
      "desc": "点击关闭",
      "rules": [
        {
          "activityIds": ".plugin.brandservice.ui.flutter.BizFlutterTLFlutterViewActivity",
          "matches": "View[childCount=2] > View[desc$=\"推​荐​\" || desc$=\"推​薦​\"][childCount=3] > ImageView[index=2][clickable=true][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 26,
      "name": "功能类-付款后自动点击完成/返回商家",
      "fastQuery": true,
      "rules": [
        {
          "key": 0,
          "activityIds": ".framework.app.UIPageFragmentActivity",
          "matches": "[vid=\"kinda_button_impl_wrapper\"][desc=\"完成\" || desc=\"返回商家\"]"
        },
        {
          "key": 1,
          "versionCode": {
            "minimum": 2980
          },
          "activityIds": [
            ".plugin.lite.ui.WxaLiteAppTransparentLiteUI",
            ".plugin.lite.ui.WxaLiteAppLiteUI",
            ".plugin.lite.ui.WxaLiteAppPayTransparentLiteUI"
          ],
          "matches": "@Button[desc=\"完成\" || desc=\"返回商家\" || desc=\"Done\"][visibleToUser=true] -n [desc=\"支付成功\"] < * <<6 FrameLayout <<3 [id=\"android:id/content\"]"
        }
      ]
    },
    {
      "key": 27,
      "name": "功能类-收款后自动[返回]",
      "desc": "已收款,点击左上角退出该界面",
      "rules": [
        {
          "fastQuery": true,
          "activityIds": ".plugin.remittance.ui.RemittanceDetailUI",
          "matches": [
            "[text*=\"已收款\"] + [text^=\"¥\"]",
            "[vid=\"actionbar_up_indicator\"][clickable=true]"
          ]
        }
      ]
    },
    {
      "key": 28,
      "name": "分段广告-订阅号消息-视频推荐",
      "desc": "点击[X]-点击[不喜欢此类视频]-点击[确定]",
      "activityIds": ".plugin.brandservice.ui.flutter.BizFlutterTLFlutterViewActivity",
      "rules": [
        {
          "key": 0,
          "name": "点击[X]",
          "matches": "[desc=\"订阅号消息\"] +3 View >2 [visibleToUser=true] - View >3 ImageView[index=2][clickable=true]"
        },
        {
          "preKeys": 0,
          "key": 1,
          "name": "点击[不喜欢此类视频]",
          "matches": "[desc=\"不喜欢此类视频\"][clickable=true]"
        },
        {
          "preKeys": 1,
          "key": 2,
          "name": "点击[确定]",
          "matches": "[desc=\"确定\"][clickable=true]"
        }
      ]
    },
    {
      "key": 29,
      "name": "功能类-解锁 Windows 微信",
      "desc": "点击[解锁]",
      "rules": [
        {
          "fastQuery": true,
          "activityIds": ".plugin.webwx.ui.WebWXUnlockUI",
          "anyMatches": [
            "[text=\"解锁\" || text=\"解鎖\"][clickable=true][visibleToUser=true]",
            "@[text=\"解锁\" || text=\"解鎖\"][clickable=true] < LinearLayout -2 [text^=\"解锁\" || text=\"解鎖\"][visibleToUser=true]"
          ]
        }
      ]
    },
    {
      "key": 30,
      "name": "全屏广告-文档页面-腾讯文档APP弹窗",
      "desc": "点击关闭",
      "rules": [
        {
          "fastQuery": true,
          "activityIds": ".plugin.webview.ui.tools.MMWebViewUI",
          "matches": "@TextView[clickable=true] + * > [visibleToUser=true][text^=\"使用 APP\"] <<n [id=\"android:id/content\"]"
        }
      ]
    },
    {
      "key": 31,
      "name": "分段广告-订阅号消息-推荐阅读",
      "desc": "点击关闭",
      "activityIds": ".plugin.brandservice.ui.flutter.BizFlutterTLFlutterViewActivity",
      "rules": [
        {
          "key": 0,
          "matches": "View > Button > View[desc$=\"推​荐​\"] > ImageView[index=1][clickable=true][visibleToUser=true]"
        },
        {
          "preKeys": [
            0
          ],
          "key": 1,
          "matches": "[desc=\"不看此类内容\"]"
        },
        {
          "preKeys": [
            1
          ],
          "key": 2,
          "matches": "[desc=\"确定\"]"
        }
      ]
    },
    {
      "key": 32,
      "name": "权限提示-权限申请弹窗",
      "desc": "点击取消",
      "matchTime": 10000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "fastQuery": true,
          "activityIds": ".pluginsdk.permission.PermissionActivity",
          "matches": [
            "[text=\"权限申请\"]",
            "[text=\"取消\"]"
          ]
        }
      ]
    },
    {
      "key": 34,
      "name": "功能类-付款时自动点击[支付]",
      "actionMaximum": 1,
      "rules": [
        {
          "key": 0,
          "fastQuery": true,
          "activityIds": ".framework.app.UIPageFragmentActivity",
          "matches": "ViewGroup + ViewGroup > ViewGroup > [vid=\"kinda_button_impl_wrapper\"][desc=\"支付\"]"
        },
        {
          "key": 1,
          "matchRoot": true,
          "forcedTime": 100000,
          "versionCode": {
            "minimum": 2960
          },
          "activityIds": ".plugin.lite.ui.WxaLiteAppTransparentLiteUI",
          "matches": "[desc^=\"付款方式\"] + Button[desc=\"支付\"][visibleToUser=true]"
        }
      ]
    },
    {
      "key": 35,
      "name": "分段广告-公众号文章内广告",
      "desc": "广告入口及反馈按钮绑定广告控件/feedback_icon和同一菜单；不按正文中的广告、不感兴趣、与我无关文字直接点击。",
      "activityIds": [
        ".plugin.brandservice.ui.timeline.preload.ui.TmplWebView",
        ".plugin.webview.ui.tools.fts.MMSosWebViewUI",
        ".plugin.webview.ui.tools.MMWebViewUI"
      ],
      "rules": [
        {
          "key": 0,
          "excludeMatches": [
            "[text=\"不感兴趣\" || text=\"与我无关\" || text=\"感谢你的反馈\"][visibleToUser=true]"
          ],
          "anyMatches": [
            "@[id=\"feedbackTagContainer\"][visibleToUser=true][width>0 && height>0] > [text~=\"^广告 *$\"][visibleToUser=true]",
            "@View[childCount=2][width<500 && height<200][visibleToUser=true][width>0 && height>0] > [text=\"广告\"][visibleToUser=true] + [text=\"feedback_icon\"][visibleToUser=true]",
            "[id=\"ad_container\"][visibleToUser=true] >3 @View[childCount=2][clickable=true][visibleToUser=true][width>0 && height>0] > [text~=\"^广告 *$\"][visibleToUser=true]"
          ]
        },
        {
          "preKeys": [
            0
          ],
          "key": 20,
          "matches": "[id=\"feedbackTagContainer\"][visibleToUser=true] + [id=\"menu1\"][visibleToUser=true] > @[id=\"closeBtn\"][text=\"关闭此广告\"][visibleToUser=true][width>0 && height>0]"
        },
        {
          "preKeys": [
            0
          ],
          "key": 25,
          "excludeMatches": [
            "[text=\"感谢你的反馈\"][visibleToUser=true]",
            "[text=\"关闭此广告\"][visibleToUser=true]"
          ],
          "anyMatches": [
            "[id=\"feedbackTagContainer\"][visibleToUser=true] + [id=\"menu1\"][visibleToUser=true] > @[id=\"dislike\"][text=\"不感兴趣\"][visibleToUser=true][width>0 && height>0]",
            "[text=\"广告\"][visibleToUser=true] + [text=\"feedback_icon\"][visibleToUser=true] <2 View[childCount=2][visibleToUser=true] < View[parent!=null][childCount=2][visibleToUser=true][width>0 && width<500 && height>0 && height<200] > View[childCount=2][index=1][visibleToUser=true][top>=parent.bottom][top<parent.bottom.plus(parent.height)] > @[text=\"不感兴趣\"][visibleToUser=true][width>0 && height>0] + [text=\"投诉\"][visibleToUser=true]"
          ]
        },
        {
          "preKeys": [
            25
          ],
          "key": 50,
          "anyMatches": [
            "[id=\"feedbackTagContainer\"][visibleToUser=true] + [id=\"menu2\"][visibleToUser=true] > @[id=\"isdismatch\"][text=\"与我无关\"][visibleToUser=true][width>0 && height>0]",
            "[text=\"广告\"][visibleToUser=true] + [text=\"feedback_icon\"][visibleToUser=true] <2 View[childCount=2][visibleToUser=true] < View[parent!=null][childCount=2][visibleToUser=true][width>0 && width<500 && height>0 && height<200] > View[childCount=3][index=1][visibleToUser=true][top>=parent.bottom][top<parent.bottom.plus(parent.height)] > @[text=\"与我无关\"][visibleToUser=true][width>0 && height>0] + [text=\"重复收到多次\"][visibleToUser=true] + [text=\"内容太差\"][visibleToUser=true]"
          ]
        }
      ],
      "matchRoot": true
    },
    {
