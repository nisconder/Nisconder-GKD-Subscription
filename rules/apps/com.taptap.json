{
  "id": "com.taptap",
  "name": "TapTap",
  "groups": [
    {
      "key": 2,
      "name": "分段广告-游戏浏览页面推荐广告",
      "desc": "点击[]对此内容不感兴趣]",
      "fastQuery": true,
      "rules": [
        {
          "key": 0,
          "activityIds": ".other.basic.impl.TapMainActivity",
          "matches": "[id=\"com.taptap.app.middle:id/decision_layout_mask\"] + @[id=\"com.taptap.app.game:id/app_menu\"][visibleToUser=true]"
        },
        {
          "key": 1,
          "activityIds": [
            ".game.discovery.impl.findgame.allgame.dialog.FindGameMenuDialog",
            ".other.basic.impl.TapMainActivity"
          ],
          "matches": "@LinearLayout > [text=\"对此内容不感兴趣\"]"
        }
      ]
    },
    {
      "key": 3,
      "name": "更新提示",
      "fastQuery": true,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "activityIds": ".upgrade.library.dialog.UpgradeDialogAct",
          "matches": "@[vid=\"btn_dismiss\"] -2 * >2 [text=\"发现新版本\"]"
        }
      ]
    },
    {
      "key": 4,
      "name": "青少年模式-首页顶部横幅提示",
      "fastQuery": true,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "matches": "[text*=\"青少年模式\"] + [vid=\"iv_close\"]"
        }
      ]
    }
  ]
}
