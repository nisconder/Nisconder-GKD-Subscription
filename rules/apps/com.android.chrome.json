{
  "id": "com.android.chrome",
  "name": "Chrome",
  "groups": [
    {
      "key": 1,
      "name": "功能类-文件可能有害-点击[仍然下载]",
      "desc": "警告⚠️：会跳过有害文件警告，请谨慎开启",
      "rules": [
        {
          "fastQuery": true,
          "activityIds": "org.chromium.chrome.browser.ChromeTabbedActivity",
          "matches": [
            "[text=\"文件可能有害\"][visibleToUser=true]",
            "[text=\"仍然下载\"][visibleToUser=true]"
          ]
        }
      ]
    }
  ]
}
