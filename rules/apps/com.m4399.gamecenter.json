        {
          "key": 1,
          "name": "首页右侧悬浮广告",
          "fastQuery": true,
          "activityIds": ".plugin.main.controllers.ApplicationActivity",
          "matches": "@[vid=\"close\"] + [vid=\"image\"]"
        }
      ]
    },
    {
      "key": 2,
      "name": "全屏广告-弹窗广告",
      "desc": "点击关闭",
      "matchTime": 10000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "fastQuery": true,
          "matches": "[vid=\"image\"] + [vid=\"close\"]"
        }
      ]
    }
  ]
}
