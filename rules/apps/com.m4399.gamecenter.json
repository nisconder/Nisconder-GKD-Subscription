{
  "id": "com.m4399.gamecenter",
  "name": "4399游戏盒",
  "groups": [
    {
      "key": 1,
      "name": "局部广告-悬浮广告",
      "matchTime": 10000,
      "actionMaximum": 1,
      "resetMatch": "app",
