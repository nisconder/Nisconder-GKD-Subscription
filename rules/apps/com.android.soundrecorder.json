{
  "id": "com.android.soundrecorder",
  "name": "录音机",
  "groups": [
    {
      "key": 1,
      "name": "更新提示",
      "fastQuery": true,
      "matchTime": 10000,
      "actionMaximum": 1,
      "resetMatch": "app",
      "rules": [
        {
          "activityIds": ".RecordPreviewActivity",
          "matches": "@[text=\"以后再说\"] + [text=\"立即更新\"]"
        }
      ]
    }
  ]
}
